{
  "name": "client-signal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"const fs = require('fs'); if (fs.existsSync('public/_next')) fs.rmSync('public/_next', {recursive: true, force: true})\"",
    "build": "next build",
    "build:ci": "cross-env NEXT_PUBLIC_SUPABASE_URL=https://synthetic-pilot.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=synthetic-pilot-key-not-a-secret npm run build",
    "postbuild": "node scripts/postbuild.js",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "secrets:scan": "secretlint --secretlintignore .secretlintignore \"**/*\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test:run && npm run secrets:scan && npm run audit:prod && npm run build:ci"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "next": "15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20.11.24",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.18",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "secretlint": "13.0.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": "24.15.0"
  }
}
